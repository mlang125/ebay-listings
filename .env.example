# Copy to .env and fill in. .env is ignored by git; this file is the template.
# Values only: no inline comments, no quotes needed.

# eBay developer app keys (developer.ebay.com > Application Keys / User Tokens).
# The Cert IDs are secrets and go in the Keychain, not here (see README).
SANDBOX_CLIENT_ID=YourName-yourapp-SBX-0000000000-00000000
SANDBOX_RU_NAME=Your_Name-YourName-yourap-xxxxxxx
PRODUCTION_CLIENT_ID=YourName-yourapp-PRD-0000000000-00000000
PRODUCTION_RU_NAME=Your_Name-YourName-yourap-xxxxxxx

# Business policy IDs on the real account (Seller Hub > Account > Business policies,
# or GET /sell/account/v1/{fulfillment,payment,return}_policy).
FULFILLMENT_POLICY_ID=000000000000
PAYMENT_POLICY_ID=000000000000
RETURN_POLICY_ID=000000000000

# Ship-from address for the inventory location
SHIP_FROM_NAME=Your Name
SHIP_FROM_ADDRESS_LINE1=123 Main St
SHIP_FROM_CITY=Anytown
SHIP_FROM_STATE=TX
SHIP_FROM_POSTAL_CODE=00000
